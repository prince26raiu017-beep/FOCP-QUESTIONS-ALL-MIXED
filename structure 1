#include <stdio.h>
struct student
{
    int rollnumber;
    char name[20];
    float marks;
};
int main()
{
    struct student s1;
    printf("enter roll number: ");
    scanf("%d",&s1.rollnumber);
    printf("enter your name: ");
    scanf("%s",&s1.name);
    printf("enter marks: ");
    scanf("%f",&s1.marks);

    printf("\n--- student details ---\n");
    printf("roll number: %d\n",s1.rollnumber);
    printf("name: %s\n",s1.name);
    printf("marks: %2f\n",s1.marks);

    return 0;


}
